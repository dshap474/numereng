# Deny by default inside this directory.
# Only explicitly allowlisted skills are tracked.
*

# Keep this policy file tracked.
!.gitignore

# Shared OSS skills.
!experiment-design/
!experiment-design/**
!experiment-ops/
!experiment-ops/**
!numerai-api-ops/
!numerai-api-ops/**
!model-implement-custom/
!model-implement-custom/**
!utility-store-ops/
!utility-store-ops/**


# Keep Python cache artifacts in allowlisted skills local-only.
numerai-api-ops/**/__pycache__/
numerai-api-ops/**/*.py[cod]
model-implement-custom/**/__pycache__/
model-implement-custom/**/*.py[cod]
experiment-ops/**/__pycache__/
experiment-ops/**/*.py[cod]
utility-store-ops/**/__pycache__/
utility-store-ops/**/*.py[cod]
